# Ignore IDE and editor-specific files
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Ignore log files and temporary files
*.log
.logs/
tmp/
temp/
__pycache__/
*.bk*
*.backup
.ipynb_checkpoints/
*.egg-info/
.legacy_hr/

# Ignore sensitive information (e.g., configuration files with credentials)
.auth/
config.local.js
.*env*
*cred*
token.pickle
token.json
credentials.json
*.json
!package.json
!.agents/hooks.json
!.agents/skill-stack.json

# Ignore sensitive data
data/*
!data/.gitkeep
!data/category_mapping.example.json
*.bin
src/data/chroma_db/*
tailwindcss
venv/
node_modules/

#Ignore Scratch work
scratch/
scripts/analyze_scripts/sync_gcp_secrets.*
scripts/deployment_scripts

**/check_status.py
