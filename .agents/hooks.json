{
  "porter-constitutional-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ../scripts/agent_lifecycle_hooks.py pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ../scripts/agent_lifecycle_hooks.py post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "uv run --no-project python ../scripts/agent_lifecycle_hooks.py stop",
        "timeout": 10
      }
    ]
  }
}
